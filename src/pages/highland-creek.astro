---
import BaseLayout from '../layouts/BaseLayout.astro';
import { agentSchema, breadcrumbSchema } from '../lib/schema';
import { siteConfig } from '../siteConfig';
import HighlandCreekComps from '../components/HighlandCreekComps.astro';

const path = '/highland-creek/';
const schemas = [
    agentSchema,
    breadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Highland Creek Homeowner Guide', path },
    ]),

];
---

<BaseLayout
    title="Highland Creek Homeowner Guide | Ridgefield & Bell's Mills | Inga Draper"
    description="Check nearby recorded sale prices for your Ridgefield or Bell's Mills home in Highland Creek. Ask Inga Draper for a complimentary Home Review and practical prep advice."
    path={path}
    schemas={schemas}
>
    <main class="homeowner-guide bg-ivory">
        <div class="site-shell">
            <div class="guide-identity flex flex-wrap items-center justify-between gap-x-6 border-b border-line py-2 text-sm">
                <a href="/" class="guide-link inline-flex min-h-11 items-center font-medium">← Inga Draper</a>
                <span>{siteConfig.agent.designation} · {siteConfig.compliance.legalBrokerageName}</span>
            </div>
            <section class="guide-intro" aria-labelledby="guide-heading">
                <div>
                <p class="eyebrow">For Highland Creek Homeowners</p>
                <h1 id="guide-heading" class="mt-3 max-w-[23ch] text-3xl font-extrabold leading-[1.12] sm:text-5xl">What sold near your Highland Creek home?</h1>
                <p class="mt-4 max-w-2xl text-base leading-6 sm:text-lg sm:leading-7">Look up your Ridgefield or Bell's Mills address to compare up to five similar Highland Creek homes with county-recorded sales.</p>
                </div>
                <aside class="guide-note" aria-label="About this guide">
                    <p class="eyebrow">Your neighborhood, in context</p>
                    <p>Start with the recorded sales. Then consider what makes your home different.</p>
                    <span>No signup needed to explore.</span>
                </aside>
            </section>

            <HighlandCreekComps>
                <div slot="review-form" class="review-email rounded-[8px] border p-5 sm:p-6">
                    <h4 class="text-xl font-semibold">Request your complimentary Highland Creek Home Review</h4>
                    <p class="mt-3 leading-7">Tell Inga about your home. Required fields are marked required.</p>
                    <form id="home-review-form" class="review-form mt-5" aria-describedby="home-review-status">
                        <label for="review-name">Name (required)</label>
                        <input id="review-name" name="name" type="text" autocomplete="name" minlength="2" maxlength="80" required />
                        <label for="review-email">Email (required)</label>
                        <input id="review-email" name="email" type="email" autocomplete="email" required />
                        <label for="review-address">Property address (required)</label>
                        <input id="review-address" name="address" type="text" autocomplete="street-address" minlength="5" maxlength="200" required />
                        <label for="review-message">Message (optional)</label>
                        <textarea id="review-message" name="message" rows="4" maxlength="1500"></textarea>
                        <div class="review-honeypot" aria-hidden="true">
                            <label for="review-website">Leave this field empty</label>
                            <input id="review-website" name="website" type="text" tabindex="-1" autocomplete="off" />
                        </div>
                        <button class="review-button mt-5 min-h-12 w-full rounded-[6px] px-5 py-3 text-sm font-medium" type="submit" disabled>WANT INGA’S TAKE?</button>
                    </form>
                    <p id="home-review-status" class="mt-3 text-sm leading-6" role="status" aria-live="polite">The online form is not available. Please contact Inga directly.</p>
                </div>
            </HighlandCreekComps>
        </div>

    </main>

    <script is:inline>
        (() => {
            const form = document.getElementById('home-review-form');
            const status = document.getElementById('home-review-status');
            const button = form.querySelector('button');
            const fields = ['name', 'email', 'address', 'message'];
            const input = (name) => form.elements.namedItem(name);
            for (const name of fields) input(name).addEventListener('input', () => input(name).setCustomValidity(''));
            button.disabled = false;
            status.textContent = '';
            form.addEventListener('submit', async (event) => {
                event.preventDefault();
                for (const name of fields) input(name).setCustomValidity('');
                const values = Object.fromEntries([...fields, 'website'].map((name) => [name, input(name).value.trim()]));
                if (values.name.length < 2) input('name').setCustomValidity('Please enter at least 2 characters.');
                if (values.address.length < 5) input('address').setCustomValidity('Please enter at least 5 characters.');
                if (!form.reportValidity()) return;
                if (values.website) {
                    status.textContent = 'Something went wrong. Please email Inga using the address below.';
                    return;
                }
                if (!values.message) delete values.message;
                button.disabled = true;
                status.textContent = 'Sending…';
                try {
                    const response = await fetch('https://forms.ingadraper.com/lead', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify(values),
                    });
                    const result = await response.json();
                    if (response.status === 200 && result?.ok === true && typeof result.requestId === 'string' && result.requestId.trim() && result.mode === 'dry-run') {
                        status.textContent = 'The online form is not available. Please email Inga using the address below.';
                    } else if (response.status === 200 && result?.ok === true && typeof result.requestId === 'string' && result.requestId.trim()) {
                        form.reset();
                        status.textContent = 'Thank you. Your Home Review request has been sent.';
                    } else if (response.status === 422 && result?.ok === false && result.error === 'invalid' && result.fields && typeof result.fields === 'object' && ['name', 'email', 'address'].some((name) => result.fields[name])) {
                        for (const name of ['name', 'email', 'address']) {
                            if (result.fields[name]) input(name).setCustomValidity('Please check this field.');
                        }
                        status.textContent = 'Please check the highlighted fields.';
                        form.reportValidity();
                    } else {
                        status.textContent = 'Something went wrong. Please email Inga using the address below.';
                    }
                } catch {
                    status.textContent = 'Something went wrong. Please email Inga using the address below.';
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>

    <style>
        .homeowner-guide { font-weight: 400; }
        .guide-intro { display: grid; gap: 1.5rem; padding: 2rem 0; align-items: end; }
        .guide-note { border-left: 2px solid #cbb9b4; padding-left: 1.25rem; max-width: 32ch; }
        .guide-note > p:not(.eyebrow) { font-family: 'Cormorant Garamond', serif; font-size: 1.65rem; line-height: 1.2; color: #2c2c2c; margin: .75rem 0; }
        .guide-note span { font-size: .875rem; }

        @media (min-width: 960px) { .guide-intro { grid-template-columns: minmax(0, 1fr) 18rem; gap: 4rem; padding: 3rem 0; } }
        @media (max-width: 639px) { .guide-note { max-width: none; } .guide-note > p:not(.eyebrow) { font-size: 1.3rem; } }
        @media (prefers-reduced-motion: reduce) { :global(html:has(.homeowner-guide)) { scroll-behavior: auto; } }

        .homeowner-guide .eyebrow { color: #7a2e48; }
        .homeowner-guide .guide-link { color: #7a2e48; text-decoration: underline; text-underline-offset: 4px; }
        .homeowner-guide .guide-link:hover { color: #2c2c2c; }
        .homeowner-guide :is(a, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
        .homeowner-guide section[id] { scroll-margin-top: 1.5rem; }
        .review-email { border-color: #e1c4be; }
        .review-button { color: #2c2c2c; background: #f0ddd8; }
        .review-button:hover { background: #fffdf8; }
        .review-button:disabled { opacity: .7; }
        .review-form label { display: block; margin-top: 1rem; font-size: .875rem; font-weight: 600; }
        .review-form input, .review-form textarea { display: block; width: 100%; margin-top: .35rem; padding: .65rem; border: 1px solid #8b7772; border-radius: 6px; background: #fff; color: #202020; }
        .review-form :is(input, textarea, button):focus-visible { outline: 2px solid #7a2e48; outline-offset: 3px; }
        .review-honeypot { position: absolute; left: -10000px; width: 1px; height: 1px; overflow: hidden; }
        /* Highland Creek only: preserve the shared footer markup and its disclosures.
           Official NAR black artwork, proportionately resized from 600px to 192px:
           https://www.nar.realtor/sites/default/files/2025-07/nar_membershipmark_black.png
           The 108px canvas plus 26px padding (18px left) preserves at least half a block-R
           of clear space on every side. Existing REALTOR® text names this decoration. */
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])) {
            display: grid;
            grid-template-columns: 96px 152px;
            align-items: center;
            justify-content: start;
            row-gap: 24px;
            column-gap: 0;
        }
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"]) > div) {
            grid-column: 1 / -1;
            min-width: 0;
        }
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])::after) {
            --hc-realtor-artwork: url("data:image/png;base64,");
            content: "";
            background-image: var(--hc-realtor-artwork);
            background-size: 108px 108px;
            background-position: center;
            background-origin: content-box;
            background-repeat: no-repeat;
            display: block;
            box-sizing: content-box;
            width: 108px;
            height: 108px;
            padding: 26px 26px 26px 18px;
            grid-column: 2;
            grid-row: 2;
        }
        .homeowner-guide + :global(footer img[alt="Equal Housing Opportunity"]) {
            width: 92px;
            height: 92px;
            object-fit: contain;
            mix-blend-mode: multiply;
            justify-self: center;
            grid-column: 1;
            grid-row: 2;
        }
        @media (min-width: 768px) {
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])) {
                grid-template-columns: minmax(0, 1fr) 96px 152px;
            }
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"]) > div) {
                grid-column: 1;
            }
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])::after) {
                grid-column: 3;
                grid-row: 1;
            }
            .homeowner-guide + :global(footer img[alt="Equal Housing Opportunity"]) {
                grid-column: 2;
                grid-row: 1;
            }
        }
    </style>
</BaseLayout>
