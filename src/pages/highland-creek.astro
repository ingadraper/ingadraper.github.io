---
import BaseLayout from '../layouts/BaseLayout.astro';
import { agentSchema, breadcrumbSchema, faqSchema } from '../lib/schema';
import { siteConfig } from '../siteConfig';
import market from '../data/highland-creek-market.json';
import HighlandCreekComps from '../components/HighlandCreekComps.astro';

const formatDate = (value: string) => new Intl.DateTimeFormat('en-US', {
    month: 'long',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
}).format(new Date(`${value}T00:00:00Z`));

// Fail the build rather than render malformed dates, incomplete records or aggregate data.
const validDate = (value: string) => /^\d{4}-\d{2}-\d{2}$/.test(value)
    && Number.isFinite(Date.parse(`${value}T00:00:00Z`))
    && new Date(`${value}T00:00:00Z`).toISOString().slice(0, 10) === value;
const positiveInteger = (value: number) => Number.isSafeInteger(value) && value > 0;
const nonnegativeInteger = (value: number) => Number.isSafeInteger(value) && value >= 0;
if (market.schemaVersion !== 1 || !validDate(market.sourcesChecked) || market.sales.length !== 2
    || !market.scope || !market.sourceName || new Set(market.sales.map((sale) => sale.mls)).size !== 2
    || market.sales.some((sale) => !validDate(sale.closed) || sale.closed > market.sourcesChecked
        || !sale.address.trim() || ![sale.priceUSD, sale.beds, sale.fullBaths, sale.sqft].every(positiveInteger)
        || ![sale.halfBaths, sale.cumulativeDOM].every(nonnegativeInteger)
        || !/^\d{7}$/.test(sale.mls)
        || sale.propertyType !== 'Single Family Home' || sale.subdivision !== 'Highland Creek'
        || sale.city !== 'Charlotte' || sale.county !== 'Mecklenburg'
        || sale.sourceUrl !== `https://www.terravistarealty.com/sold-single-property-details.cfm?PID=${sale.mls}`)) {
    throw new Error('Invalid Highland Creek selected-sale data. Review the dated source records before building.');
}

const checked = formatDate(market.sourcesChecked);
const mls = market.mlsContext;
const closingDates = market.sales.map((sale) => sale.closed).sort();
const formatNumber = (value: number) => value.toLocaleString('en-US');
const formatPrice = (value: number) => new Intl.NumberFormat('en-US', {
    style: 'currency', currency: 'USD', maximumFractionDigits: 0,
}).format(value);
const offer = 'Request your complimentary Highland Creek Home Review';
const emailBody = [
    'Hi Inga, I would like a complimentary Highland Creek Home Review.',
    '',
    'Property address (optional):',
    'Updates or maintenance questions:',
    'What I would like to understand:',
    '',
    'Please include recent comparable sales, a likely price range and practical prep considerations.',
].join(String.fromCharCode(13, 10));
const homeValueHref = `mailto:${siteConfig.contact.email}?subject=${encodeURIComponent('Highland Creek Home Review')}&body=${encodeURIComponent(emailBody)}`;
const faqs = [
    {
        question: 'Maintenance or cosmetic work first?',
        answer: 'Start with known repairs and records of past work. Talk with Inga before spending on cosmetic changes for a sale.',
    },
    {
        question: 'Which sales make useful comparisons?',
        answer: 'Compare size, layout, condition, lot and sale date. Updates and seller concessions matter too. Sale prices alone cannot tell you what your home is worth.',
    },
    {
        question: 'Does my project need HOA approval?',
        answer: 'Check Highland Creek’s design guidelines and architectural review (ARC) process before work begins. Confirm your project’s requirements with the association.',
    },
];
const path = '/highland-creek/';
const schemas = [
    agentSchema,
    breadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Highland Creek Homeowner Guide', path },
    ]),
    faqSchema(faqs),
];
---

<BaseLayout
    title="Highland Creek Homeowner Guide | Ridgefield & Bell's Mills | Inga Draper"
    description="Check nearby recorded sale prices for your Ridgefield or Bell's Mills home in Highland Creek. Ask Inga Draper for a complimentary Home Review and practical prep advice."
    path={path}
    schemas={schemas}
>
    <main class="homeowner-guide bg-ivory">
        <div class="site-shell">
            <div class="guide-identity flex flex-wrap items-center justify-between gap-x-6 border-b border-line py-2 text-sm">
                <a href="/" class="guide-link inline-flex min-h-11 items-center font-medium">← Inga Draper</a>
                <span>{siteConfig.agent.designation} · {siteConfig.compliance.legalBrokerageName}</span>
            </div>
            <section class="py-6 sm:py-10" aria-labelledby="guide-heading">
                <p class="eyebrow">For Highland Creek Homeowners</p>
                <h1 id="guide-heading" class="mt-3 max-w-[23ch] text-3xl font-extrabold leading-[1.12] sm:text-5xl">SO... WHAT DO YOUR NEIGHBORS KNOW?</h1>
                <p class="mt-4 max-w-2xl text-base leading-6 sm:text-lg sm:leading-7">Highland Creek homeowners have had a lot to watch lately.</p>
                <dl class="campaign-stats mt-6 grid grid-cols-3 gap-3 sm:gap-6">
                    <div><dt>Closed listings</dt><dd>{formatNumber(mls.closedCount)}</dd></div>
                    <div><dt>Median closed price</dt><dd>{formatPrice(mls.medianClosedPrice)}</dd></div>
                    <div><dt>Median cumulative days on market</dt><dd>{mls.medianCumulativeDaysOnMarket} days</dd></div>
                </dl>
                <p class="guide-source-note mt-3">{mls.source} · {formatDate(mls.periodStart)}–{formatDate(mls.periodEnd)} · Checked {formatDate(mls.checkedAt.slice(0, 10))}. Charlotte single-family closed listings reported as Highland Creek, not a parcel-verified Ridgefield/Bell's Mills inventory. A dated snapshot, not a live feed.</p>
                <details class="guide-attribution mt-1">
                    <summary class="guide-link min-h-11 cursor-pointer py-2">MLS scope &amp; attribution</summary>
                    <p>{mls.scope}</p>
                    <p class="mt-2">{mls.disclaimer}</p>
                </details>
                <h2 class="mt-8 max-w-3xl text-2xl font-extrabold leading-tight sm:text-3xl">BUT THAT’S NOT REALLY THE INTERESTING PART.</h2>
                <p class="mt-4 max-w-3xl text-lg leading-7">Your neighbor’s sale doesn’t automatically tell you what your home is worth.</p>
                <p class="mt-3 max-w-3xl leading-7">Two homes in the same neighborhood can sell for very different prices based on condition, updates, layout, lot, location, timing, and buyer demand.</p>
            </section>

            <HighlandCreekComps />
        </div>

        <section id="home-review" class="guide-review bg-charcoal py-10 sm:py-14" aria-labelledby="review-heading">
            <div class="site-shell grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:gap-12">
                <div>
                    <h2 id="review-heading" class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">THE NUMBERS ARE USEFUL. THE CONTEXT MATTERS MORE.</h2>
                    <p class="mt-5 max-w-2xl text-lg leading-8">An automated comparison can’t see your kitchen, your renovations, your lot, your floor plan, your maintenance, or the details that make one Highland Creek home sell differently from another.</p>
                    <p class="mt-4 text-lg leading-8">That’s where I come in.</p>
                    <p class="mt-4 max-w-2xl text-lg leading-8">If you want, I’ll take a look at your home and tell you where I think it fits in the current market.</p>
                    <p class="guide-review-note mt-4 max-w-xl">Your complimentary Home Review includes comparable sales, a likely price range and practical prep considerations. The range depends on your home's condition and available information. A Home Review is not an appraisal or a guaranteed sale price.</p>
                    <a href="#snapshot" class="guide-link mt-4 inline-flex min-h-11 items-center text-sm">↓ More sale examples</a>
                </div>
                <div class="review-email rounded-[8px] border p-5 sm:p-6">
                    <h3 class="text-2xl font-semibold">{offer}</h3>
                    <p id="email-helper" class="mt-3 leading-7">Open your email app, add your questions and send when ready. Your address is optional. Nothing is sent automatically.</p>
                    <a href={homeValueHref} class="review-button mt-5 inline-flex min-h-12 w-full items-center justify-center rounded-[6px] px-5 py-3 text-center text-sm font-medium" aria-describedby="email-helper">WANT INGA’S TAKE? <span class="ml-2" aria-hidden="true">↗</span></a>
                    <p class="mt-5 text-sm leading-6">Or contact Inga directly:</p>
                    <a href={`mailto:${siteConfig.contact.email}`} class="guide-link contact-email inline-flex min-h-11 items-center text-sm">{siteConfig.contact.email}</a>
                    <br />
                    <a href={siteConfig.contact.phoneHref} class="guide-link inline-flex min-h-11 items-center text-sm">{siteConfig.contact.phone}</a>
                </div>
            </div>
        </section>

        <div class="site-shell">
            <section id="snapshot" class="py-10 sm:py-14" aria-labelledby="market-heading">
                <h2 id="market-heading" class="mb-5 max-w-3xl text-3xl font-extrabold leading-tight sm:text-4xl">WHAT’S HAPPENING IN HIGHLAND CREEK RIGHT NOW?</h2>
                <p class="mb-5 max-w-3xl leading-7">Start with the dated snapshot below, then ask Inga about current conditions. These figures do not auto-refresh.</p>
                <HighlandCreekComps section="market" />
                <details class="guide-examples">
                    <summary id="sales-heading" class="guide-link min-h-11 cursor-pointer py-3 text-xl font-semibold">Two more Highland Creek sale examples</summary>
                <div class="border-t border-line pt-5">
                    <p class="guide-source-note mt-2">Sources checked <time datetime={market.sourcesChecked}>{checked}</time></p>
                </div>
                <div class="mt-4 grid gap-4 md:grid-cols-2">
                    {market.sales.map((sale) => (
                        <article class="sale-card rounded-[8px] border border-line bg-frosted p-5 sm:p-6" aria-labelledby={`sale-${sale.mls}`}>
                            <h3 id={`sale-${sale.mls}`} class="text-xl font-semibold leading-tight sm:text-2xl">{sale.address}</h3>
                            <p class="guide-source-note mt-2">Closed <time datetime={sale.closed}>{formatDate(sale.closed)}</time></p>
                            <p class="sale-price mt-2 font-display text-3xl font-semibold text-ink sm:text-4xl">{formatPrice(sale.priceUSD)}</p>
                            <dl class="sale-facts mt-4 grid grid-cols-2 gap-x-4 gap-y-3 border-t border-line pt-3 text-sm">
                                <div><dt>Bedrooms</dt><dd>{sale.beds}</dd></div>
                                <div><dt>Bathrooms</dt><dd>{sale.fullBaths} full + {sale.halfBaths} half</dd></div>
                                <div><dt>Size</dt><dd>{formatNumber(sale.sqft)} sq. ft.</dd></div>
                                <div><dt>Cumulative days on market</dt><dd>{sale.cumulativeDOM}</dd></div>
                            </dl>
                            <a href={sale.sourceUrl} class="guide-link guide-source-note mt-2 inline-flex min-h-11 items-center">{market.sourceName} sale details · MLS {sale.mls} <span class="ml-1" aria-hidden="true">↗</span></a>
                        </article>
                    ))}
                </div>
                <p class="guide-source-note mt-3 max-w-4xl" id="source-note">
                    Two single-family examples from {market.sourceName}, not a complete Ridgefield/Bell's Mills inventory or a price estimate. Closings: {formatDate(closingDates[0])}–{formatDate(closingDates[closingDates.length - 1])}. Both are listed as Highland Creek, Charlotte / Mecklenburg County; village boundaries are unverified. These examples are separate from the county comparisons above.
                </p>
                </details>
            </section>
        </div>

        <section class="border-y border-line bg-porcelain py-10 sm:py-14" aria-labelledby="questions-heading">
            <div class="site-shell">
                <h2 id="questions-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">THINKING ABOUT SELLING SOMEDAY?</h2>
                <p class="mt-4 max-w-2xl leading-7">Before you spend on updates, start with the questions that matter for your home.</p>
                <div class="mt-6 grid gap-6 lg:grid-cols-3">
                    {faqs.map((faq) => (
                        <article class="border-t border-line pt-5">
                            <h3 class="text-xl font-semibold leading-snug">{faq.question}</h3>
                            <p class="mt-3 leading-7">{faq.answer}</p>
                        </article>
                    ))}
                </div>

            </div>
        </section>

        <div class="site-shell pt-10 sm:pt-14">
            <HighlandCreekComps section="methodology" />
            <section class="pb-10 sm:pb-14" aria-labelledby="resources-heading">
                <h2 id="resources-heading" class="text-3xl font-extrabold leading-tight sm:text-4xl">HIGHLAND CREEK HOMEOWNER RESOURCES</h2>
                <div class="mt-6 grid gap-6 sm:grid-cols-2">
                    <div>
                        <h3 class="text-xl font-semibold">Community &amp; home projects</h3>
                        <ul class="mt-3 text-sm">
                            <li><a href="https://www.highlandcreek.com/community-info/" class="guide-link inline-flex min-h-11 items-center">Official HOA resources &amp; ARC information ↗</a></li>
                            <li><a href="https://www.highlandcreek.com/wp-content/uploads/2026/04/ARC-Form-General-HCCA-Updated-4.23.26.pdf" class="guide-link inline-flex min-h-11 items-center">General architectural approval request (PDF) ↗</a></li>
                            <li><a href="https://www.highlandcreek.com/maps" class="guide-link inline-flex min-h-11 items-center">Official community map: Ridgefield &amp; Bell's Mills ↗</a></li>
                        </ul>
                    </div>
                    <div>
                        <h3 class="text-xl font-semibold">Selling &amp; your next steps</h3>
                        <ul class="mt-3 text-sm">
                            <li><a href="/selling/" class="guide-link inline-flex min-h-11 items-center">Inga's seller guide</a></li>
                            <li><a href="#home-review" class="guide-link inline-flex min-h-11 items-center">Get a complimentary Home Review <span class="ml-1" aria-hidden="true">↑</span></a></li>
                        </ul>
                    </div>
                </div>
            </section>
        </div>
    </main>

    <style>
        .homeowner-guide { font-weight: 400; }
        .guide-source-note { font-size: .75rem; line-height: 1.5; }
        .guide-attribution, .guide-review-note { font-size: .8125rem; line-height: 1.5; }
        .campaign-stats > div { display: flex; flex-direction: column; gap: .35rem; border-top: 2px solid #cbb9b4; padding-top: .75rem; min-width: 0; }
        .campaign-stats dt { font-size: .8125rem; line-height: 1.4; }
        .campaign-stats dd { order: -1; color: #2c2c2c; font-size: clamp(1.17rem, 4.8vw, 2.75rem); font-weight: 600; line-height: 1.2; }
        @media (max-width: 359px) { .campaign-stats { gap: .375rem; } }
        .homeowner-guide .eyebrow { color: #7a2e48; }
        .homeowner-guide .guide-link { color: #7a2e48; text-decoration: underline; text-underline-offset: 4px; }
        .homeowner-guide .guide-link:hover { color: #2c2c2c; }
        .homeowner-guide :is(a, summary):focus-visible { outline: 2px solid currentColor; outline-offset: 4px; }
        .homeowner-guide section[id] { scroll-margin-top: 1.5rem; }
        .sale-card { box-shadow: 0 12px 32px rgba(122, 46, 72, .05); }
        .sale-facts dt { font-size: .8125rem; }
        .sale-facts dd { color: #2c2c2c; font-weight: 500; }
        .guide-review { color: #fdfaf5; }
        .guide-review h2, .guide-review h3, .guide-review .eyebrow,
        .guide-review .guide-link { color: #fdfaf5; }
        .guide-review .guide-link:hover { color: #f0ddd8; }
        .review-email { border-color: #e1c4be; }
        .review-button { color: #2c2c2c; background: #f0ddd8; }
        .review-button:hover { background: #fffdf8; }
        .guide-review .review-button:focus-visible { outline-color: #fdfaf5; }
        .contact-email { overflow-wrap: anywhere; }
        /* Highland Creek only: preserve the shared footer markup and its disclosures.
           Official NAR black artwork, proportionately resized from 600px to 192px:
           https://www.nar.realtor/sites/default/files/2025-07/nar_membershipmark_black.png
           The 108px canvas plus 26px padding (18px left) preserves at least half a block-R
           of clear space on every side. Existing REALTOR® text names this decoration. */
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])) {
            display: grid;
            grid-template-columns: 96px 152px;
            align-items: center;
            justify-content: start;
            row-gap: 24px;
            column-gap: 0;
        }
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"]) > div) {
            grid-column: 1 / -1;
            min-width: 0;
        }
        .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])::after) {
            --hc-realtor-artwork: url("data:image/png;base64,");
            content: "";
            background-image: var(--hc-realtor-artwork);
            background-size: 108px 108px;
            background-position: center;
            background-origin: content-box;
            background-repeat: no-repeat;
            display: block;
            box-sizing: content-box;
            width: 108px;
            height: 108px;
            padding: 26px 26px 26px 18px;
            grid-column: 2;
            grid-row: 2;
        }
        .homeowner-guide + :global(footer img[alt="Equal Housing Opportunity"]) {
            width: 92px;
            height: 92px;
            object-fit: contain;
            mix-blend-mode: multiply;
            justify-self: center;
            grid-column: 1;
            grid-row: 2;
        }
        @media (min-width: 768px) {
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])) {
                grid-template-columns: minmax(0, 1fr) 96px 152px;
            }
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"]) > div) {
                grid-column: 1;
            }
            .homeowner-guide + :global(footer .site-shell > div:has(> img[alt="Equal Housing Opportunity"])::after) {
                grid-column: 3;
                grid-row: 1;
            }
            .homeowner-guide + :global(footer img[alt="Equal Housing Opportunity"]) {
                grid-column: 2;
                grid-row: 1;
            }
        }
    </style>
</BaseLayout>
