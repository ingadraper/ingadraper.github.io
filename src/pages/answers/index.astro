---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { answerPages } from '../../content/answers';
import { agentSchema, breadcrumbSchema } from '../../lib/schema';

const categories = ['Buying', 'Selling', 'Relocation', 'Rental strategy', 'Local guide'] as const;

const grouped = categories
    .map((category) => ({
        category,
        pages: answerPages.filter((page) => page.category === category),
    }))
    .filter((group) => group.pages.length > 0);

const schemas = [
    agentSchema,
    breadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Answers', path: '/answers/' },
    ]),
    {
        '@context': 'https://schema.org',
        '@type': 'CollectionPage',
        name: 'Charlotte Real Estate Answers',
        url: 'https://ingadraper.com/answers/',
        about: 'Straight answers to questions Charlotte-area buyers, sellers, and investors ask.',
        hasPart: answerPages.map((page) => ({
            '@type': 'Article',
            headline: page.title,
            url: `https://ingadraper.com/answers/${page.slug}/`,
        })),
    },
];
---

<BaseLayout
    title="Charlotte Real Estate Answers | Inga Draper"
    description="Straight answers to the questions Charlotte, Huntersville, Cornelius, and Lake Norman buyers, sellers, and investors actually ask."
    path="/answers/"
    schemas={schemas}
>
    <main class="min-h-screen bg-ivory">
        <section class="section-band">
            <div class="site-shell">
                <nav aria-label="Breadcrumb" class="text-sm text-smoke">
                    <a href="/" class="transition hover:text-ink">Home</a>
                </nav>

                <p class="eyebrow mt-8">Answers</p>
                <h1 class="mt-4 max-w-3xl text-4xl font-extrabold sm:text-5xl">
                    Straight answers to the questions people actually ask.
                </h1>
                <p class="mt-6 max-w-2xl text-lg text-smoke">
                    Each page answers one question directly, then explains the reasoning behind it. If your
                    situation is not covered here, ask Inga and it will likely become a page.
                </p>

                {grouped.map((group) => (
                    <section class="mt-14">
                        <h2 class="text-2xl font-extrabold">{group.category}</h2>
                        <div class="mt-6 grid gap-4 md:grid-cols-2">
                            {group.pages.map((page) => (
                                <a href={`/answers/${page.slug}/`} class="soft-card block p-6 transition hover:border-dusty">
                                    <h3 class="text-xl font-extrabold">{page.question}</h3>
                                    <p class="mt-3 text-sm text-smoke">{page.answer.slice(0, 150)}…</p>
                                    <p class="mt-4 text-sm font-medium text-deep-rose">Read the answer →</p>
                                </a>
                            ))}
                        </div>
                    </section>
                ))}
            </div>
        </section>
    </main>
</BaseLayout>
