---
import { ArrowLeft, ArrowRight, Check, MapPin } from '@lucide/astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import SiteHeader from '../../components/SiteHeader.astro';
import { answerPages, type AnswerPage } from '../../content/answers';
import { sourceSets } from '../../content/sources';
import { agentSchema, articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';
import { siteConfig } from '../../siteConfig';

function validateAnswerContent() {
    const slugs = answerPages.map((page) => page.slug);
    const slugSet = new Set(slugs);
    const duplicateSlugs = slugs.filter((slug, index) => slugs.indexOf(slug) !== index);
    const missingSourceSets = slugs.filter((slug) => !sourceSets[slug]?.length);
    const orphanedSourceSets = Object.keys(sourceSets).filter((slug) => !slugSet.has(slug));
    const invalidSourceDates = Object.entries(sourceSets).flatMap(([slug, sources]) =>
        sources
            .filter((source) =>
                !/^\d{4}-\d{2}-\d{2}$/.test(source.checked)
                || Number.isNaN(Date.parse(`${source.checked}T00:00:00Z`)),
            )
            .map((source) => `${slug} -> ${source.checked}`),
    );
    const invalidRelated = answerPages.flatMap((page) =>
        page.related
            .filter((slug) => !slugSet.has(slug))
            .map((slug) => `${page.slug} -> ${slug}`),
    );

    const errors = [
        duplicateSlugs.length && `duplicate answer slugs: ${duplicateSlugs.join(', ')}`,
        missingSourceSets.length && `answer slugs without sources: ${missingSourceSets.join(', ')}`,
        orphanedSourceSets.length && `source sets without answers: ${orphanedSourceSets.join(', ')}`,
        invalidSourceDates.length && `sources with invalid checked dates: ${invalidSourceDates.join(', ')}`,
        invalidRelated.length && `invalid related-answer slugs: ${invalidRelated.join(', ')}`,
    ].filter(Boolean);

    if (errors.length) {
        throw new Error(`Answer content validation failed: ${errors.join('; ')}`);
    }
}

validateAnswerContent();

export function getStaticPaths() {
    const includeUnverified = process.env.INCLUDE_UNVERIFIED_ANSWERS === 'true';
    const visiblePages = includeUnverified
        ? answerPages
        : answerPages.filter((page) => !page.needsVerification);
    return visiblePages.map((page) => ({ params: { slug: page.slug }, props: { page } }));
}

interface Props { page: AnswerPage }
const { page } = Astro.props;
const path = `/answers/${page.slug}/`;
const includeUnverified = process.env.INCLUDE_UNVERIFIED_ANSWERS === 'true';
const visibleAnswerPages = includeUnverified
    ? answerPages
    : answerPages.filter((candidate) => !candidate.needsVerification);
const relatedPages = page.related
    .map((slug) => visibleAnswerPages.find((candidate) => candidate.slug === slug))
    .filter((candidate): candidate is AnswerPage => Boolean(candidate));
const schemas = [
    agentSchema,
    articleSchema({
        headline: page.title,
        description: page.metaDescription,
        path,
        datePublished: page.datePublished,
        dateModified: page.dateModified,
    }),
    faqSchema(page.faqs),
    breadcrumbSchema([
        { name: 'Home', url: 'https://ingadraper.com/' },
        { name: 'Answers', url: 'https://ingadraper.com/answers/' },
        { name: page.question, url: `https://ingadraper.com${path}` },
    ]),
];
const heroImage = siteConfig.images.about;
const displayQuestion = page.question.replaceAll('short-term', 'short‑term');
const sources = sourceSets[page.slug] ?? [];
const sourceKicker = page.needsVerification ? 'Sources for review' : 'Sources checked';
const sourceHeading = page.needsVerification ? 'This draft still needs review' : 'Where this information comes from';
const sourceDescription = page.needsVerification
    ? 'These public sources support parts of this draft, but the page is not ready to publish yet. Legal, tax, insurance, or local-rule details still need the right professional review.'
    : 'These are the public sources used for the facts on this page. Rules and boundaries can change, so the date beside each source shows when it was last checked.';
const formatSourceDate = (date: string) =>
    new Date(`${date}T12:00:00`).toLocaleDateString('en-US', {
        month: 'long',
        day: 'numeric',
        year: 'numeric',
    });
---

<BaseLayout title={`${page.title} | Inga Draper`} description={page.metaDescription} path={path} schemas={schemas}>
    <SiteHeader active="answers" />

    <main>
        <section class="relative overflow-hidden bg-[#2C2927] text-ivory">
            <div class="absolute inset-y-0 right-0 hidden w-[44%] lg:block">
                <img
                    src={heroImage.src}
                    srcset={heroImage.srcset}
                    sizes="44vw"
                    width={heroImage.width}
                    height={heroImage.height}
                    alt=""
                    class="h-full w-full object-cover opacity-80"
                />
                <div class="absolute inset-0 bg-gradient-to-r from-[#2C2927] via-[#2C2927]/30 to-transparent"></div>
            </div>

            <div class="site-shell relative grid min-h-[520px] items-center py-16 lg:grid-cols-[1.05fr_0.75fr] lg:py-20">
                <div class="max-w-3xl">
                    <a href="/answers/" class="inline-flex items-center gap-2 text-xs font-medium uppercase tracking-[0.18em] text-ivory/65 transition hover:text-ivory">
                        <ArrowLeft class="h-4 w-4" /> Plain-English answers
                    </a>
                    <p class="mt-8 font-subheading text-sm font-semibold uppercase tracking-[0.2em] text-dusty sm:mt-12">{page.category}</p>
                    <h1 class="mt-5 max-w-[18ch] text-4xl font-extrabold leading-[1.05] text-ivory sm:text-5xl lg:text-6xl">
                        {displayQuestion}
                    </h1>
                    <p class="mt-7 max-w-xl text-base font-normal leading-7 text-ivory/90 sm:text-lg sm:leading-8">{page.answer}</p>
                    <div class="mt-8 flex flex-col items-start gap-2 text-sm text-ivory/75 sm:flex-row sm:flex-wrap sm:items-center sm:gap-x-5">
                        <span>By {siteConfig.agent.name}, {siteConfig.agent.designation}</span>
                        <span class="hidden h-1 w-1 rounded-full bg-dusty sm:block"></span>
                        <span>Updated {new Date(`${page.dateModified}T12:00:00`).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' })}</span>
                    </div>
                </div>
            </div>
        </section>

        <section class="bg-ivory py-12 sm:py-20 lg:py-28">
            <div class="site-shell grid gap-14 lg:grid-cols-[minmax(0,1fr)_340px] lg:gap-20">
                <article class="answer-prose max-w-3xl">
                    {page.sections.map((section, index) => (
                        <section class:list={[index > 0 && 'mt-14 border-t border-line/70 pt-14']}>
                            <p class="eyebrow text-base text-deep-rose">{String(index + 1).padStart(2, '0')}</p>
                            <h2 class="mt-3 text-3xl font-extrabold leading-tight sm:text-4xl">{section.heading}</h2>
                            <p class="mt-6 text-lg leading-8 text-smoke">{section.body}</p>
                            {section.bullets && (
                                <ul class="mt-7 grid gap-4">
                                    {section.bullets.map((bullet) => (
                                        <li class="flex gap-4 border-b border-line/55 pb-4 text-base leading-7 text-smoke last:border-0">
                                            <span class="mt-1.5 flex h-5 w-5 flex-none items-center justify-center rounded-full bg-blush text-deep-rose">
                                                <Check class="h-3 w-3" stroke-width={2.5} />
                                            </span>
                                            <span>{bullet}</span>
                                        </li>
                                    ))}
                                </ul>
                            )}
                        </section>
                    ))}
                </article>

                <aside class="lg:pt-2">
                    <div class="sticky top-8 overflow-hidden rounded-[8px] border border-line bg-frosted shadow-[0_22px_60px_rgba(122,46,72,0.10)]">
                        <div class="bg-blush p-7">
                            <p class="font-subheading text-sm font-semibold uppercase tracking-[0.18em] text-deep-rose">What to do next</p>
                            <h2 class="mt-3 text-2xl font-extrabold leading-tight">Start with the address and what matters to you.</h2>
                            <p class="mt-4 text-sm leading-6 text-smoke">The answer can change from one home or neighborhood to the next. Inga can help you find the right office, document, or question, then explain how the answer fits your plans.</p>
                        </div>
                        <div class="space-y-5 p-7">
                            <div class="flex gap-3 text-sm text-smoke">
                                <MapPin class="mt-0.5 h-4 w-4 flex-none text-dusty" />
                                <span>Charlotte, Huntersville, Cornelius, Davidson & Lake Norman</span>
                            </div>
                            <a href="/#contact" class="btn-primary w-full">Talk with Inga <ArrowRight class="h-4 w-4" /></a>
                            <p class="text-center text-sm leading-5 text-smoke">NC License #351209 · SC License #147132</p>
                        </div>
                    </div>
                </aside>
            </div>
        </section>

        {sources.length > 0 && (
            <section class="border-y border-line bg-frosted py-12 sm:py-16">
                <div class="site-shell grid gap-7 lg:grid-cols-[0.55fr_1.45fr] lg:gap-16">
                    <div>
                        <p class="eyebrow">{sourceKicker}</p>
                        <h2 class="mt-3 text-3xl font-extrabold">{sourceHeading}</h2>
                        <p class="mt-4 max-w-md text-sm leading-6 text-smoke">
                            {sourceDescription}
                        </p>
                    </div>
                    <ol class="grid gap-3">
                        {sources.map((source, index) => (
                            <li class="rounded-[8px] border border-line bg-ivory px-5 py-4">
                                <a href={source.url} target="_blank" rel="noreferrer" class="group grid gap-1 sm:grid-cols-[2rem_1fr_auto] sm:items-start sm:gap-3">
                                    <span class="font-subheading text-xs font-semibold tracking-[0.12em] text-deep-rose">{String(index + 1).padStart(2, '0')}</span>
                                    <span>
                                        <strong class="block text-base font-semibold text-ink transition group-hover:text-deep-rose">{source.title}</strong>
                                        <span class="mt-1 block text-sm text-smoke">{source.publisher}</span>
                                    </span>
                                    <span class="text-xs text-slate">Checked {formatSourceDate(source.checked)}</span>
                                </a>
                            </li>
                        ))}
                    </ol>
                </div>
            </section>
        )}

        <section class="section-band bg-porcelain">
            <div class="site-shell">
                <div class="grid gap-10 lg:grid-cols-[0.75fr_1.25fr]">
                    <div>
                        <p class="eyebrow">Common questions</p>
                        <h2 class="mt-4 max-w-md text-4xl font-extrabold sm:text-5xl">A few more things people ask.</h2>
                    </div>
                    <div class="divide-y divide-line border-y border-line">
                        {page.faqs.map((faq) => (
                            <details class="group py-6">
                                <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-medium text-ink">
                                    <span>{faq.question}</span>
                                    <span class="text-2xl font-light text-dusty transition group-open:rotate-45">+</span>
                                </summary>
                                <p class="max-w-2xl pt-4 leading-7 text-smoke">{faq.answer}</p>
                            </details>
                        ))}
                    </div>
                </div>
            </div>
        </section>

        <section class="section-band bg-ivory">
            <div class="site-shell">
                <div class="flex flex-col gap-4 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="eyebrow">Keep exploring</p>
                        <h2 class="mt-3 text-4xl font-extrabold">Related questions</h2>
                    </div>
                    <a href="/answers/" class="inline-flex items-center gap-2 text-sm font-medium text-ink">View every answer <ArrowRight class="h-4 w-4" /></a>
                </div>
                <div class="mt-8 grid gap-px overflow-hidden rounded-[8px] border border-line bg-line md:grid-cols-3">
                    {relatedPages.map((related) => (
                        <a href={`/answers/${related.slug}/`} class="group bg-frosted p-7 transition hover:bg-blush">
                            <p class="font-subheading text-xs font-semibold uppercase tracking-[0.16em] text-slate">{related.category}</p>
                            <h3 class="mt-4 text-xl font-extrabold leading-snug transition group-hover:text-deep-rose">{related.question}</h3>
                            <span class="mt-7 inline-flex items-center gap-2 text-sm font-medium text-smoke">Read the answer <ArrowRight class="h-4 w-4" /></span>
                        </a>
                    ))}
                </div>
            </div>
        </section>
    </main>
    <!-- Editorial verification state remains in source data; it is intentionally not public UI. -->
</BaseLayout>
