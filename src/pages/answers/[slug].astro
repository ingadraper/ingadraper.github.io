---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { answerPages, type AnswerPage } from '../../content/answers';
import { agentSchema, articleSchema, breadcrumbSchema, faqSchema } from '../../lib/schema';

export function getStaticPaths() {
    return answerPages.map((page) => ({
        params: { slug: page.slug },
        props: { page },
    }));
}

interface Props {
    page: AnswerPage;
}

const { page } = Astro.props;
const path = `/answers/${page.slug}/`;

const related = page.related
    .map((slug) => answerPages.find((candidate) => candidate.slug === slug))
    .filter((candidate): candidate is AnswerPage => Boolean(candidate));

const schemas = [
    agentSchema,
    articleSchema({
        headline: page.title,
        description: page.metaDescription,
        path,
        datePublished: page.datePublished,
        dateModified: page.dateModified,
    }),
    faqSchema([{ question: page.question, answer: page.answer }, ...page.faqs]),
    breadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Answers', path: '/answers/' },
        { name: page.question, path },
    ]),
];

const formattedDate = new Date(`${page.dateModified}T00:00:00Z`).toLocaleDateString('en-US', {
    year: 'numeric',
    month: 'long',
    day: 'numeric',
    timeZone: 'UTC',
});
---

<BaseLayout title={`${page.title} | Inga Draper`} description={page.metaDescription} path={path} schemas={schemas}>
    <main class="min-h-screen bg-ivory">
        <article class="section-band">
            <div class="site-shell max-w-3xl">
                <nav aria-label="Breadcrumb" class="text-sm text-smoke">
                    <a href="/" class="transition hover:text-ink">Home</a>
                    <span aria-hidden="true" class="px-2">/</span>
                    <a href="/answers/" class="transition hover:text-ink">Answers</a>
                </nav>

                <p class="eyebrow mt-8">{page.category}</p>

                <h1 class="mt-4 text-4xl font-extrabold sm:text-5xl">{page.question}</h1>

                {page.needsVerification && (
                    <aside class="mt-8 rounded-xl border-2 border-dashed border-deep-rose bg-porcelain p-5">
                        <p class="text-sm font-medium text-ink">Draft — requires verification before publication</p>
                        <p class="mt-2 text-sm text-smoke">{page.verificationNote}</p>
                    </aside>
                )}

                {/* The extractable direct answer. This is the block an answer engine lifts. */}
                <div class="mt-8 rounded-xl bg-blush p-6">
                    <p class="text-lg font-medium leading-relaxed text-ink">{page.answer}</p>
                </div>

                <p class="mt-4 text-sm text-smoke">
                    By <strong class="font-medium text-ink">Inga Draper</strong>, REALTOR®, eXp Realty ·
                    <span> Updated <time datetime={page.dateModified}>{formattedDate}</time></span>
                </p>

                {page.sections.map((section) => (
                    <section class="mt-12">
                        <h2 class="text-2xl font-extrabold sm:text-3xl">{section.heading}</h2>
                        <p class="mt-4 text-lg text-smoke">{section.body}</p>
                        {section.bullets && (
                            <ul class="mt-5 space-y-3">
                                {section.bullets.map((bullet) => (
                                    <li class="flex gap-3 text-smoke">
                                        <span class="mt-2 h-1.5 w-1.5 flex-none rounded-full bg-dusty" aria-hidden="true"></span>
                                        <span>{bullet}</span>
                                    </li>
                                ))}
                            </ul>
                        )}
                    </section>
                ))}

                <section class="mt-16">
                    <h2 class="text-2xl font-extrabold sm:text-3xl">Common follow-up questions</h2>
                    <div class="mt-6 space-y-4">
                        {page.faqs.map((faq) => (
                            <div class="soft-card p-6">
                                <h3 class="text-lg font-extrabold">{faq.question}</h3>
                                <p class="mt-3 text-smoke">{faq.answer}</p>
                            </div>
                        ))}
                    </div>
                </section>

                <section class="mt-16 rounded-xl bg-porcelain p-8">
                    <h2 class="text-2xl font-extrabold">Talk it through with Inga</h2>
                    <p class="mt-3 text-smoke">
                        Every property and timeline is different. If you are weighing this decision now, a short
                        conversation is usually faster than more reading.
                    </p>
                    <div class="mt-6 flex flex-wrap gap-4">
                        <a href="/#contact" class="rounded-full bg-deep-rose px-7 py-3 font-medium text-white transition hover:bg-dusty">
                            Start a conversation
                        </a>
                        <a href="tel:+17045609101" class="rounded-full border border-line px-7 py-3 font-medium text-ink transition hover:bg-blush">
                            (704) 560-9101
                        </a>
                    </div>
                </section>

                {related.length > 0 && (
                    <section class="mt-16">
                        <h2 class="text-2xl font-extrabold">Related questions</h2>
                        <ul class="mt-6 space-y-3">
                            {related.map((item) => (
                                <li>
                                    <a href={`/answers/${item.slug}/`} class="text-lg text-deep-rose transition hover:text-ink">
                                        {item.question}
                                    </a>
                                </li>
                            ))}
                        </ul>
                    </section>
                )}
            </div>
        </article>
    </main>
</BaseLayout>
