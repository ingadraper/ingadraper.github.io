---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Hero from '../components/Hero.astro';
import PropertyStrategy from '../components/PropertyStrategy.astro';
import Reviews from '../components/Reviews.astro';
import Services from '../components/Services.astro';
import YouTube from '../components/YouTube.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../siteConfig';
---

<BaseLayout title="Inga Draper | Charlotte Real Estate Advisor" description="Charlotte and Lake Norman real estate guidance from Inga Draper, eXp Realty. Buyer, seller, relocation, investment, and property strategy conversations.">
    <main class="min-h-screen bg-ivory">
        <Hero />
        <About />
        <Services />
        <PropertyStrategy />
        <YouTube />
        <Reviews />
        <Contact />

        <footer class="bg-porcelain py-12 text-ink">
            <div class="site-shell">
                <div class="grid gap-8 border-b border-line pb-8 sm:grid-cols-2 lg:grid-cols-4">
                    <div>
                        <h3 class="font-display text-2xl font-semibold">Inga Draper</h3>
                        <p class="mt-4 text-sm text-smoke">
                            eXp Realty agent serving Charlotte, Huntersville, Cornelius, and Lake Norman.
                        </p>
                    </div>

                    <div>
                        <h4 class="font-semibold">Explore</h4>
                        <ul class="mt-4 space-y-2 text-sm text-smoke">
                            <li><a href="#about" class="transition hover:text-ink">About</a></li>
                            <li><a href="#services" class="transition hover:text-ink">Services</a></li>
                            <li><a href="#strategy" class="transition hover:text-ink">Strategy</a></li>
                            <li><a href="#contact" class="transition hover:text-ink">Contact</a></li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="font-semibold">Focus</h4>
                        <ul class="mt-4 space-y-2 text-sm text-smoke">
                            <li>Buyer, seller, and relocation guidance</li>
                            <li>Charlotte + Lake Norman perspective</li>
                            <li>Short-term rental readiness questions</li>
                            <li>Property strategy conversations</li>
                        </ul>
                    </div>

                    <div>
                        <h4 class="font-semibold">Connect</h4>
                        <ul class="mt-4 space-y-2 text-sm text-smoke">
                            <li><a href={siteConfig.contact.phoneHref} class="transition hover:text-ink">{siteConfig.contact.phone}</a></li>
                            <li><a href={`mailto:${siteConfig.contact.email}`} class="transition hover:text-ink">Email Inga</a></li>
                            <li><a href={siteConfig.links.youtube} target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">{siteConfig.youtube.channelName}</a></li>
                            <li><a href={siteConfig.links.facebook} target="_blank" rel="noopener noreferrer" class="transition hover:text-ink">Facebook</a></li>
                        </ul>
                    </div>
                </div>

                <p class="pt-8 text-sm text-smoke">
                    (c) 2026 Inga Draper Real Estate. eXp Realty. Equal Housing Opportunity.
                </p>
            </div>
        </footer>
    </main>
</BaseLayout>