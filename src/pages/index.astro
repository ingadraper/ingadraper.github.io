---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Hero from '../components/Hero.astro';
import PropertyStrategy from '../components/PropertyStrategy.astro';
import Reviews from '../components/Reviews.astro';
import Services from '../components/Services.astro';
import YouTube from '../components/YouTube.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../siteConfig';
import { agentSchema } from '../lib/schema';

const { brand } = siteConfig;
---

<BaseLayout
    title="Helping You Find Your Fit in Charlotte | Inga Draper"
    description={`Inga Draper of ${brand.brokerageName} helps buyers, sellers, and people moving to Charlotte find the home, neighborhood, and next step that fit their lives, with real estate explained in plain English.`}
    path="/"
    schemas={[agentSchema]}
>
    <main class="min-h-screen bg-ivory">
        <Hero />
        <About />
        <Services />
        <PropertyStrategy />
        <YouTube />
        <Reviews />
        <Contact />
    </main>
</BaseLayout>