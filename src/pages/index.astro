---
import About from '../components/About.astro';
import Contact from '../components/Contact.astro';
import Hero from '../components/Hero.astro';
import PropertyStrategy from '../components/PropertyStrategy.astro';
import Reviews from '../components/Reviews.astro';
import Services from '../components/Services.astro';
import YouTube from '../components/YouTube.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteConfig } from '../siteConfig';
import { agentSchema } from '../lib/schema';

const { brand } = siteConfig;
---

<BaseLayout
    title="Helping You Find Your Fit in Charlotte | Inga Draper"
    description={`Inga Draper of ${brand.brokerageName} helps buyers, sellers, and people moving to Charlotte find the home, neighborhood, and next step that fit their lives, with real estate explained in plain English.`}
    path="/"
    schemas={[agentSchema]}
>
    <main class="min-h-screen bg-ivory">
        <Hero />
        <About />
        <Services />
        <section class="bg-ivory pb-16 sm:pb-20" aria-labelledby="highland-creek-resource-heading">
            <div class="site-shell">
                <div class="soft-card grid gap-6 p-6 sm:p-8 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div>
                        <p class="eyebrow">A neighborhood resource</p>
                        <h2 id="highland-creek-resource-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">Own a home in Highland Creek?</h2>
                        <p class="mt-4 max-w-2xl text-base leading-7 text-smoke">Selected Highland Creek sales and practical prep questions for Ridgefield and Bell's Mills homeowners.</p>
                    </div>
                    <a href="/highland-creek/" class="btn-primary">See the homeowner guide <span aria-hidden="true">→</span></a>
                </div>
            </div>
        </section>
        <PropertyStrategy />
        <YouTube />
        <Reviews />
        <Contact />
    </main>
</BaseLayout>