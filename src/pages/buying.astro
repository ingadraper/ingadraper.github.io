---
import {
    ArrowRight,
    Check,
    ClipboardCheck,
    HeartHandshake,
    KeyRound,
    MapPin,
    Search,
} from '@lucide/astro';
import Contact from '../components/Contact.astro';
import SiteHeader from '../components/SiteHeader.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { agentSchema, breadcrumbSchema, SITE } from '../lib/schema';
import { siteConfig } from '../siteConfig';

const path = '/buying/';
const canonical = `${SITE}${path}`;
const title = 'Buying a Home in Charlotte | Inga Draper';
const description =
    'Inga Draper helps Charlotte-area home buyers compare homes and neighborhoods, understand the process in plain English, and make informed choices from the first search through closing.';

const buyingServiceSchema = {
    '@context': 'https://schema.org',
    '@type': 'Service',
    '@id': `${canonical}#service`,
    name: 'Charlotte-Area Home Buying Guidance',
    serviceType: 'Residential home buying guidance',
    description,
    url: canonical,
    provider: { '@id': `${SITE}/#business` },
    areaServed: [
        'Charlotte, NC',
        'Huntersville, NC',
        'Cornelius, NC',
        'Davidson, NC',
        'Mooresville, NC',
        'Lake Norman, NC',
    ].map((name) => ({ '@type': name === 'Lake Norman, NC' ? 'Place' : 'City', name })),
};

const schemas = [
    agentSchema,
    {
        '@context': 'https://schema.org',
        '@type': 'WebPage',
        '@id': `${canonical}#webpage`,
        name: title,
        description,
        url: canonical,
        isPartOf: { '@id': `${SITE}/#website` },
        about: { '@id': `${canonical}#service` },
        mainEntity: { '@id': `${canonical}#service` },
    },
    buyingServiceSchema,
    breadcrumbSchema([
        { name: 'Home', path: '/' },
        { name: 'Buying in Charlotte', path },
    ]),
];

const steps = [
    {
        number: '01',
        title: 'Define what fits',
        description:
            'Start with your budget, timing, regular drives, must-haves, and tradeoffs. That gives the search a useful shape before listings start competing for your attention.',
        icon: HeartHandshake,
    },
    {
        number: '02',
        title: 'Compare places and homes',
        description:
            'Narrow the search by daily life as well as the house itself. Check the exact address for school assignment, local services, property rules, and the routes you will actually drive.',
        icon: Search,
    },
    {
        number: '03',
        title: 'Understand the offer',
        description:
            'Talk through price, due diligence, earnest money, timing, and risk in plain English so you know what the offer asks of you before you sign.',
        icon: ClipboardCheck,
    },
    {
        number: '04',
        title: 'Work through closing',
        description:
            'Keep the inspections, documents, loan steps, and contract deadlines organized, with the right question going to the right professional when specialist advice is needed.',
        icon: KeyRound,
    },
];

const buyerGuides = [
    {
        label: 'First purchase',
        title: 'What does a first-time buyer need to know in Charlotte?',
        description: 'Start with due diligence, earnest money, the full monthly cost, and the questions to ask before an offer.',
        href: '/answers/first-time-home-buyer-charlotte/',
    },
    {
        label: 'North Carolina offers',
        title: 'How does the due diligence fee work?',
        description: 'See what the fee pays for, when it is at risk, and why your signed contract matters.',
        href: '/answers/north-carolina-due-diligence-fee/',
    },
    {
        label: 'Moving here',
        title: 'What should I know before relocating to Charlotte?',
        description: 'Use regular trips, exact addresses, and a focused visit to narrow the area before choosing a home.',
        href: '/answers/relocating-to-charlotte/',
    },
    {
        label: 'Address check',
        title: 'How do I verify a school assignment?',
        description: 'Find the district first, then use its official lookup for the full address and the correct school year.',
        href: '/answers/verify-school-assignment-charlotte-lake-norman/',
    },
];
---

<BaseLayout title={title} description={description} path={path} schemas={schemas}>
    <SiteHeader />

    <main>
        <nav class="border-b border-line bg-ivory" aria-label="Breadcrumb">
            <ol class="site-shell flex min-h-12 items-center gap-2 text-sm text-smoke">
                <li><a href="/" class="transition hover:text-deep-rose">Home</a></li>
                <li aria-hidden="true" class="text-line">/</li>
                <li aria-current="page" class="font-medium text-ink">Buying in Charlotte</li>
            </ol>
        </nav>

        <section class="relative overflow-hidden bg-[#2C2927] text-ivory">
            <div class="absolute inset-y-0 right-0 w-full opacity-35 sm:opacity-45 lg:w-[48%] lg:opacity-100">
                <img
                    src={siteConfig.images.hero.src}
                    srcset={siteConfig.images.hero.srcset}
                    sizes="(min-width: 1024px) 48vw, 100vw"
                    width={siteConfig.images.hero.width}
                    height={siteConfig.images.hero.height}
                    alt=""
                    class="h-full w-full object-cover"
                    fetchpriority="high"
                />
                <div class="absolute inset-0 bg-[#2C2927]/50 lg:bg-gradient-to-r lg:from-[#2C2927] lg:via-[#2C2927]/25 lg:to-transparent"></div>
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-[#2C2927]/55 via-transparent to-transparent lg:hidden"></div>

            <div class="site-shell relative grid min-h-[620px] items-center py-16 sm:py-20 lg:grid-cols-[1.05fr_0.8fr] lg:py-24">
                <div class="max-w-3xl">
                    <p class="flex items-center gap-2 text-xs font-medium uppercase tracking-[0.2em] text-ivory/80">
                        <MapPin class="h-4 w-4" aria-hidden="true" /> Charlotte + Lake Norman
                    </p>
                    <h1 class="mt-5 max-w-[13ch] text-5xl font-extrabold leading-[1.03] text-ivory sm:text-6xl lg:text-7xl">
                        Buy a home that fits your life.
                    </h1>
                    <p class="mt-7 max-w-2xl text-lg leading-8 text-ivory/90 sm:text-xl">
                        Inga helps you define what matters, compare Charlotte-area homes and neighborhoods, understand offers and deadlines, and move from search to closing with the choices explained in plain English. The goal is not simply to find a house. It is to make an informed decision about the home and location that fit you.
                    </p>
                    <div class="mt-9 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
                        <a href="#contact" class="inline-flex min-h-12 items-center justify-center gap-2 rounded-[6px] border border-ivory bg-ivory px-6 py-3 text-sm font-medium text-ink transition hover:border-blush hover:bg-blush focus:outline-none focus:ring-2 focus:ring-ivory focus:ring-offset-2 focus:ring-offset-ink">
                            Talk with Inga <ArrowRight class="h-4 w-4" aria-hidden="true" />
                        </a>
                        <a href="#process" class="inline-flex min-h-12 items-center justify-center rounded-[6px] border border-ivory/35 px-6 py-3 text-sm font-medium text-ivory transition hover:border-ivory hover:bg-white/10 focus:outline-none focus:ring-2 focus:ring-ivory focus:ring-offset-2 focus:ring-offset-ink">
                            See how buying works
                        </a>
                    </div>
                </div>
            </div>
        </section>

        <section class="border-b border-line bg-frosted py-10 sm:py-12" aria-labelledby="quick-answer-heading">
            <div class="site-shell grid gap-5 lg:grid-cols-[240px_1fr] lg:items-start lg:gap-12">
                <div>
                    <p class="eyebrow">The short answer</p>
                    <h2 id="quick-answer-heading" class="mt-3 text-2xl font-extrabold">What does Inga help a buyer do?</h2>
                </div>
                <p class="max-w-3xl text-lg leading-8 text-smoke">
                    Inga helps buyers turn a long list of listings and unfamiliar terms into a clear set of choices: where to look, what to compare, how an offer works, what to investigate, and what must happen before closing. You bring your priorities; she helps you understand how each home measures up.
                </p>
            </div>
        </section>

        <section id="process" class="section-band scroll-mt-8 bg-ivory" aria-labelledby="process-heading">
            <div class="site-shell">
                <div class="grid gap-8 border-b border-line pb-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
                    <div>
                        <p class="eyebrow">A simple buying process</p>
                        <h2 id="process-heading" class="mt-4 text-4xl font-extrabold sm:text-5xl">Know what comes next.</h2>
                    </div>
                    <p class="max-w-2xl text-lg leading-8 text-smoke lg:justify-self-end">
                        Every purchase has its own details, but the path should not feel mysterious. Inga keeps the next decision visible and explains the terms as they come up.
                    </p>
                </div>

                <ol class="mt-12 grid gap-px overflow-hidden rounded-[8px] border border-line bg-line md:grid-cols-2">
                    {steps.map((step) => {
                        const Icon = step.icon;
                        return (
                            <li class="bg-frosted p-7 sm:p-9">
                                <div class="flex items-center justify-between gap-5">
                                    <span class="font-subheading text-sm font-semibold tracking-[0.16em] text-deep-rose">{step.number}</span>
                                    <span class="flex h-11 w-11 items-center justify-center rounded-full bg-blush text-deep-rose">
                                        <Icon class="h-5 w-5" aria-hidden="true" />
                                    </span>
                                </div>
                                <h3 class="mt-8 text-2xl font-extrabold">{step.title}</h3>
                                <p class="mt-4 leading-7 text-smoke">{step.description}</p>
                            </li>
                        );
                    })}
                </ol>
            </div>
        </section>

        <section class="section-band bg-blush" aria-labelledby="different-start-heading">
            <div class="site-shell">
                <div class="max-w-3xl">
                    <p class="eyebrow">Different starting points</p>
                    <h2 id="different-start-heading" class="mt-4 text-4xl font-extrabold sm:text-5xl">First purchase or first week in Charlotte?</h2>
                    <p class="mt-6 text-lg leading-8 text-smoke">
                        You do not need to arrive knowing the process or the area. Start with the part that feels uncertain, and build the plan from there.
                    </p>
                </div>

                <div class="mt-12 grid gap-5 lg:grid-cols-2">
                    <article class="rounded-[8px] border border-dusty/45 bg-ivory p-7 sm:p-9">
                        <p class="font-subheading text-sm font-semibold uppercase tracking-[0.18em] text-deep-rose">For first-time buyers</p>
                        <h3 class="mt-4 text-3xl font-extrabold">Nothing is “obvious” until it is explained.</h3>
                        <p class="mt-5 leading-7 text-smoke">
                            Inga can walk through the language around agency, offers, due diligence, earnest money, inspections, closing costs, and monthly ownership costs. Before you commit money, you should understand what it is for, when it is at risk, and which document controls the answer.
                        </p>
                        <ul class="mt-7 space-y-4">
                            <li class="flex gap-3 text-sm leading-6 text-smoke">
                                <Check class="mt-1 h-4 w-4 flex-none text-deep-rose" aria-hidden="true" />
                                <span>Build a budget around the full cost of owning, not only the loan payment.</span>
                            </li>
                            <li class="flex gap-3 text-sm leading-6 text-smoke">
                                <Check class="mt-1 h-4 w-4 flex-none text-deep-rose" aria-hidden="true" />
                                <span>Ask questions before signing instead of translating the paperwork afterward.</span>
                            </li>
                        </ul>
                        <a href="/answers/first-time-home-buyer-charlotte/" class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-ink transition hover:text-deep-rose">
                            Read the first-time buyer guide <ArrowRight class="h-4 w-4" aria-hidden="true" />
                        </a>
                    </article>

                    <article class="rounded-[8px] border border-dusty/45 bg-ivory p-7 sm:p-9">
                        <p class="font-subheading text-sm font-semibold uppercase tracking-[0.18em] text-deep-rose">For relocating buyers</p>
                        <h3 class="mt-4 text-3xl font-extrabold">Choose around your real week, not a map label.</h3>
                        <p class="mt-5 leading-7 text-smoke">
                            Inga helps you narrow Charlotte and the Lake Norman area around the trips, routines, home type, and surroundings that matter to you. For every serious option, verify the exact address rather than relying on a listing, ZIP code, or town name for schools, services, or local rules.
                        </p>
                        <ul class="mt-7 space-y-4">
                            <li class="flex gap-3 text-sm leading-6 text-smoke">
                                <Check class="mt-1 h-4 w-4 flex-none text-deep-rose" aria-hidden="true" />
                                <span>Use remote research to narrow the search, then test the routes and areas that remain.</span>
                            </li>
                            <li class="flex gap-3 text-sm leading-6 text-smoke">
                                <Check class="mt-1 h-4 w-4 flex-none text-deep-rose" aria-hidden="true" />
                                <span>Compare actual homes and addresses instead of broad community stereotypes.</span>
                            </li>
                        </ul>
                        <a href="/answers/relocating-to-charlotte/" class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-ink transition hover:text-deep-rose">
                            Read the relocation guide <ArrowRight class="h-4 w-4" aria-hidden="true" />
                        </a>
                    </article>
                </div>
            </div>
        </section>

        <section class="section-band bg-porcelain" aria-labelledby="guides-heading">
            <div class="site-shell">
                <div class="flex flex-col gap-5 border-b border-line pb-8 sm:flex-row sm:items-end sm:justify-between">
                    <div>
                        <p class="eyebrow">Plain-English answers</p>
                        <h2 id="guides-heading" class="mt-3 text-4xl font-extrabold sm:text-5xl">Start with the question in front of you.</h2>
                    </div>
                    <a href="/answers/" class="inline-flex items-center gap-2 text-sm font-medium text-ink transition hover:text-deep-rose">
                        View every answer <ArrowRight class="h-4 w-4" aria-hidden="true" />
                    </a>
                </div>

                <div class="mt-8 grid gap-px overflow-hidden rounded-[8px] border border-line bg-line md:grid-cols-2">
                    {buyerGuides.map((guide) => (
                        <a href={guide.href} class="group flex min-h-64 flex-col justify-between bg-frosted p-7 transition hover:bg-blush sm:p-8">
                            <div>
                                <p class="font-subheading text-xs font-semibold uppercase tracking-[0.16em] text-slate">{guide.label}</p>
                                <h3 class="mt-4 text-2xl font-extrabold leading-tight transition group-hover:text-deep-rose">{guide.title}</h3>
                                <p class="mt-5 leading-7 text-smoke">{guide.description}</p>
                            </div>
                            <span class="mt-8 inline-flex items-center gap-2 text-sm font-medium text-ink">
                                Read Inga's answer <ArrowRight class="h-4 w-4 transition-transform group-hover:translate-x-1" aria-hidden="true" />
                            </span>
                        </a>
                    ))}
                </div>
            </div>
        </section>

        <section class="bg-ivory py-16 sm:py-20" aria-labelledby="ready-heading">
            <div class="site-shell">
                <div class="grid gap-8 rounded-[8px] border border-line bg-frosted p-7 sm:p-10 lg:grid-cols-[1fr_auto] lg:items-center">
                    <div>
                        <p class="eyebrow">Bring the starting point you have</p>
                        <h2 id="ready-heading" class="mt-3 text-3xl font-extrabold sm:text-4xl">You can start before you know exactly where or when.</h2>
                        <p class="mt-4 max-w-3xl text-lg leading-8 text-smoke">
                            Share your timing, budget, regular destinations, and the questions already on your list. Inga can help you sort the priorities and identify a useful next step.
                        </p>
                    </div>
                    <a href="#contact" class="btn-primary w-full lg:w-auto">Start a conversation <ArrowRight class="h-4 w-4" aria-hidden="true" /></a>
                </div>
            </div>
        </section>

        <Contact />
    </main>
</BaseLayout>
