---
import { ArrowRight, ClipboardCheck, Home, Map, Sparkles } from '@lucide/astro';

const strategyItems = [
    {
        title: 'What should you check before planning a short-term rental?',
        description: 'Check the homeowners association (HOA) rules, city or county rules, insurance, parking, setup costs, and day-to-day management before you count on rental income.',
        icon: ClipboardCheck,
    },
    {
        title: 'Should you sell it or rent it out?',
        description: 'Talk through the money, the work of being a landlord, your timeline, and how much uncertainty you are comfortable carrying.',
        icon: Home,
    },
    {
        title: 'Will the location still work for you later?',
        description: 'Compare the commute, what may matter if you sell, whether renters or guests are likely to want the area, and how the location fits your daily life.',
        icon: Map,
    },
];
---

<section id="strategy" class="section-band bg-porcelain">
    <div class="site-shell">
        <div class="grid gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:items-start">
            <div>
                <p class="eyebrow">Think past the first move</p>
                <h2 class="mt-4 text-4xl font-extrabold sm:text-5xl">
                    Should you sell your current home or keep it as a rental?
                </h2>
                <p class="mt-6 text-lg text-smoke">
                    Let’s look beyond the rent estimate. We’ll talk about the rules, carrying costs, repairs, management work, and how keeping the property could affect your next purchase. You need a plan you can live with when the home is empty or something expensive breaks.
                </p>
                <a href="#contact" class="btn-primary mt-9">
                    Talk through your options
                    <ArrowRight class="h-4 w-4" />
                </a>
            </div>

            <div class="grid gap-4">
                {strategyItems.map((item) => {
                    const Icon = item.icon;

                    return (
                        <article class="soft-card grid gap-5 p-6 sm:grid-cols-[auto_1fr]">
                            <div class="flex h-12 w-12 items-center justify-center rounded-[6px] bg-mist text-slate">
                                <Icon class="h-5 w-5" />
                            </div>
                            <div>
                                <h3 class="text-xl font-extrabold">{item.title}</h3>
                                <p class="mt-3 text-sm leading-6 text-smoke">{item.description}</p>
                            </div>
                        </article>
                    );
                })}

                <div class="rounded-[8px] border border-frosted/50 bg-ivory p-6 text-sm leading-6 text-smoke">
                    <p class="flex items-start gap-3 font-medium text-ink">
                        <Sparkles class="mt-0.5 h-4 w-4 text-slate" />
                        Helpful first step
                    </p>
                    <p class="mt-3">
                        A short checklist can help you compare HOA rules, local rental rules, parking, insurance, setup costs, and management before the search gets too far along.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>