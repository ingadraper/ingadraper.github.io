---
import { ArrowRight, ClipboardCheck, Home, Map, Sparkles } from '@lucide/astro';

const strategyItems = [
    {
        title: 'Short-term rental readiness',
        description: 'Evaluate HOA rules, municipality questions, parking, guest appeal, furnishing lift, management fit, insurance, and local due diligence before you fall in love with the property.',
        icon: ClipboardCheck,
    },
    {
        title: 'Sell, hold, or reposition',
        description: 'Talk through whether a property should be sold, refreshed, rented, or held based on your timeline, risk tolerance, and next chapter.',
        icon: Home,
    },
    {
        title: 'Neighborhood-to-use fit',
        description: 'Compare lifestyle, commute, resale, guest demand, and long-term flexibility across Charlotte, Huntersville, Cornelius, and Lake Norman.',
        icon: Map,
    },
];
---

<section id="strategy" class="section-band bg-porcelain">
    <div class="site-shell">
        <div class="grid gap-12 lg:grid-cols-[0.84fr_1.16fr] lg:items-start">
            <div>
                <p class="eyebrow">Property strategy</p>
                <h2 class="mt-4 text-4xl font-semibold sm:text-5xl">
                    A stronger lane for clients thinking beyond the transaction.
                </h2>
                <p class="mt-6 text-lg text-smoke">
                    Some clients are buying a home. Others are deciding whether a property can support a lifestyle move, rental-income plan, future resale, or short-term rental idea. Inga helps frame the right questions before the decision gets expensive.
                </p>
                <a href="#contact" class="btn-primary mt-9">
                    Ask about property strategy
                    <ArrowRight class="h-4 w-4" />
                </a>
            </div>

            <div class="grid gap-4">
                {strategyItems.map((item) => {
                    const Icon = item.icon;

                    return (
                        <article class="soft-card grid gap-5 p-6 sm:grid-cols-[auto_1fr]">
                            <div class="flex h-12 w-12 items-center justify-center rounded-[6px] bg-mist text-olive">
                                <Icon class="h-5 w-5" />
                            </div>
                            <div>
                                <h3 class="text-xl font-semibold">{item.title}</h3>
                                <p class="mt-3 text-sm leading-6 text-smoke">{item.description}</p>
                            </div>
                        </article>
                    );
                })}

                <div class="rounded-[8px] border border-rose/45 bg-ivory p-6 text-sm leading-6 text-smoke">
                    <p class="flex items-start gap-3 font-semibold text-ink">
                        <Sparkles class="mt-0.5 h-4 w-4 text-clay" />
                        Helpful first step
                    </p>
                    <p class="mt-3">
                        A short rental-readiness checklist can help compare HOA rules, parking, insurance, guest appeal, management fit, and local due diligence before the search gets too far along.
                    </p>
                </div>
            </div>
        </div>
    </div>
</section>