---
import { Building2, KeyRound, Route, ShieldCheck } from '@lucide/astro';
import editableSite from '../editable-site.json';

const icons = [KeyRound, ShieldCheck, Route, Building2];
const services = editableSite.services.items.map((service, index) => ({ ...service, icon: icons[index] }));
---

<section id="services" class="section-band bg-ivory">
    <div class="site-shell">
        <div class="grid gap-10 lg:grid-cols-[0.8fr_1.2fr] lg:items-end">
            <div>
                <p class="eyebrow">How Inga helps</p>
                <h2 class="mt-4 text-4xl font-extrabold sm:text-5xl">
                    {editableSite.services.headline}
                </h2>
            </div>
            <p class="max-w-2xl text-lg text-smoke lg:justify-self-end">
                {editableSite.services.summary}
            </p>
        </div>

        <div class="mt-12 grid gap-4 md:grid-cols-2 lg:grid-cols-4">
            {services.map((service) => {
                const Icon = service.icon;

                return (
                    <article class="soft-card p-6">
                        <div class="flex h-11 w-11 items-center justify-center rounded-full bg-mist text-slate">
                            <Icon class="h-5 w-5" />
                        </div>
                        <h3 class="mt-6 text-xl font-extrabold">{service.title}</h3>
                        <p class="mt-3 text-sm text-smoke">{service.description}</p>
                    </article>
                );
            })}
        </div>
    </div>
</section>