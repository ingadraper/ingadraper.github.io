---
import { ArrowRight, CalendarDays, Mail, MapPin, Phone } from '@lucide/astro';
import { siteConfig } from '../siteConfig';

const ghlFormUrl = siteConfig.connectors.goHighLevelFormUrl || import.meta.env.PUBLIC_GHL_FORM_URL;
const ghlCalendarUrl = siteConfig.connectors.goHighLevelCalendarUrl || import.meta.env.PUBLIC_GHL_CALENDAR_URL;
const { contact, links } = siteConfig;
---

<section id="contact" class="section-band bg-ink text-ivory">
    <div class="site-shell">
        <div class="grid gap-12 lg:grid-cols-[0.82fr_1fr] lg:items-start">
            <div>
                <p class="text-xs font-medium uppercase tracking-[0.28em] text-frosted">Let's talk</p>
                <h2 class="mt-4 text-4xl font-extrabold text-ivory sm:text-5xl">
                    Start with a quick note.
                </h2>
                <p class="mt-6 max-w-xl text-lg leading-8 text-ivory/75">
                    Share where you are in the process. Inga can help you think through timing, options, and the next practical move.
                </p>

                <div class="mt-9 space-y-5 text-sm text-ivory/80">
                    <div class="flex gap-3">
                        <Phone class="mt-0.5 h-5 w-5 text-frosted" />
                        <div>
                            <p class="font-medium text-ivory">Phone</p>
                            <a href={contact.phoneHref} class="transition hover:text-white">{contact.phone}</a>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <Mail class="mt-0.5 h-5 w-5 text-frosted" />
                        <div>
                            <p class="font-medium text-ivory">Email</p>
                            <a href={`mailto:${contact.email}`} class="transition hover:text-white">{contact.email}</a>
                        </div>
                    </div>

                    <div class="flex gap-3">
                        <MapPin class="mt-0.5 h-5 w-5 text-frosted" />
                        <div>
                            <p class="font-medium text-ivory">Service area</p>
                            <p>Charlotte, Huntersville, Cornelius, Lake Norman & surrounding areas</p>
                        </div>
                    </div>

                    {ghlCalendarUrl ? (
                        <div class="flex gap-3">
                            <CalendarDays class="mt-0.5 h-5 w-5 text-frosted" />
                            <div>
                                <p class="font-medium text-ivory">Consultation calendar</p>
                                <a href={ghlCalendarUrl} target="_blank" rel="noopener noreferrer" class="transition hover:text-white">
                                    Book a time with Inga
                                </a>
                            </div>
                        </div>
                    ) : null}
                </div>

                <div class="mt-10 flex flex-wrap gap-3">
                    <a href={links.instagram} target="_blank" rel="noopener noreferrer" class="btn-secondary border-white/20 bg-white/10 text-ivory shadow-none hover:border-white hover:bg-white/20">Instagram</a>
                    <a href={links.facebook} target="_blank" rel="noopener noreferrer" class="btn-secondary border-white/20 bg-white/10 text-ivory shadow-none hover:border-white hover:bg-white/20">Facebook</a>
                    <a href={links.youtube} target="_blank" rel="noopener noreferrer" class="btn-secondary border-white/20 bg-white/10 text-ivory shadow-none hover:border-white hover:bg-white/20">YouTube</a>
                    <a href={links.linkedin} target="_blank" rel="noopener noreferrer" class="btn-secondary border-white/20 bg-white/10 text-ivory shadow-none hover:border-white hover:bg-white/20">LinkedIn</a>
                </div>
            </div>

            <div class="rounded-[8px] border border-white/15 bg-white p-3 text-ink shadow-[0_24px_70px_rgba(0,0,0,0.18)]">
                {ghlFormUrl ? (
                    <iframe src={ghlFormUrl} title="Contact Inga Draper" class="min-h-[620px] w-full rounded-[6px] border-0" loading="lazy"></iframe>
                ) : (
                    <form id="contact-form" action={`mailto:${contact.email}`} method="post" enctype="text/plain" data-email={contact.email} class="p-5 sm:p-7">
                        <p class="eyebrow">Contact Inga</p>
                        <h3 class="mt-3 text-3xl font-extrabold">Tell Inga what you are considering.</h3>
                        <p class="mt-3 text-sm leading-6 text-smoke">
                            A short note is enough. Choose the closest topic and share what you are weighing.
                        </p>

                        <div class="mt-7 space-y-4">
                            <div>
                                <label for="interest" class="mb-2 block text-sm font-medium text-ink">Topic</label>
                                <select id="interest" name="interest" class="w-full rounded-[6px] border border-line bg-porcelain px-4 py-3 outline-none transition focus:border-slate focus:ring-2 focus:ring-slate/20">
                                    <option>Buying</option>
                                    <option>Selling</option>
                                    <option>Relocating</option>
                                    <option>Exploring rental income</option>
                                    <option>Property strategy</option>
                                </select>
                            </div>

                            <div>
                                <label for="name" class="mb-2 block text-sm font-medium text-ink">Name</label>
                                <input type="text" id="name" name="name" required class="w-full rounded-[6px] border border-line bg-porcelain px-4 py-3 outline-none transition focus:border-slate focus:ring-2 focus:ring-slate/20" />
                            </div>

                            <div class="grid gap-4 sm:grid-cols-2">
                                <div>
                                    <label for="email" class="mb-2 block text-sm font-medium text-ink">Email</label>
                                    <input type="email" id="email" name="email" required class="w-full rounded-[6px] border border-line bg-porcelain px-4 py-3 outline-none transition focus:border-slate focus:ring-2 focus:ring-slate/20" />
                                </div>

                                <div>
                                    <label for="phone" class="mb-2 block text-sm font-medium text-ink">Phone</label>
                                    <input type="tel" id="phone" name="phone" class="w-full rounded-[6px] border border-line bg-porcelain px-4 py-3 outline-none transition focus:border-slate focus:ring-2 focus:ring-slate/20" />
                                </div>
                            </div>

                            <div>
                                <label for="message" class="mb-2 block text-sm font-medium text-ink">What are you thinking about?</label>
                                <textarea id="message" name="message" rows="5" required class="w-full resize-none rounded-[6px] border border-line bg-porcelain px-4 py-3 outline-none transition focus:border-slate focus:ring-2 focus:ring-slate/20" placeholder="Buying, selling, relocating, investing, or evaluating a rental-ready property..."></textarea>
                            </div>
                        </div>

                        <p data-form-status hidden class="mt-4 rounded-[6px] bg-mist px-4 py-3 text-sm text-slate">
                            Your email app should open with the details prefilled.
                        </p>

                        <button type="submit" class="btn-primary mt-6 w-full">
                            Email these details
                            <ArrowRight class="h-4 w-4" />
                        </button>
                    </form>
                )}
            </div>
        </div>
    </div>
</section>

<script>
    const form = document.querySelector('#contact-form');

    form?.addEventListener('submit', (event) => {
        event.preventDefault();

        const data = new FormData(form);
        const email = form.getAttribute('data-email');
        const subject = encodeURIComponent(`Real estate inquiry: ${data.get('interest') || 'General'}`);
        const body = encodeURIComponent([
            `Topic: ${data.get('interest') || ''}`,
            `Name: ${data.get('name') || ''}`,
            `Email: ${data.get('email') || ''}`,
            `Phone: ${data.get('phone') || 'Not provided'}`,
            '',
            'Message:',
            data.get('message') || '',
        ].join('\n'));

        window.location.href = `mailto:${email}?subject=${subject}&body=${body}`;
        form.querySelector('[data-form-status]')?.removeAttribute('hidden');
        form.reset();
    });
</script>