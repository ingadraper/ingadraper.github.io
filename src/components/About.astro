---
import { BadgeCheck, Home, TrendingUp } from '@lucide/astro';
import { siteConfig } from '../siteConfig';

const aboutImage = siteConfig.images.about;
const stats = [
    { label: 'Sales volume', value: '$6.5M+' },
    { label: 'Google & Zillow rating', value: '5.0' },
    { label: 'Licensed in both states', value: 'NC & SC' },
];
---

<section id="about" class="section-band bg-porcelain">
    <div class="site-shell">
        <div class="grid gap-12 lg:grid-cols-[0.92fr_1.08fr] lg:items-center">
            <div class="relative min-h-[420px] overflow-hidden rounded-[8px] bg-ink sm:min-h-[520px] lg:min-h-[560px]">
                <img src={aboutImage.src} alt={aboutImage.alt} class="absolute inset-0 h-full w-full object-cover brightness-[0.94] saturate-[0.92]" />
                <div class="absolute inset-x-5 bottom-5 rounded-[6px] border border-line/70 bg-ivory/95 p-5 shadow-[0_16px_40px_rgba(12,15,36,0.10)] sm:inset-x-6 sm:bottom-6 sm:p-6">
                    <p class="text-xs font-medium uppercase tracking-[0.2em] text-slate">Working style</p>
                    <p class="mt-3 max-w-2xl text-lg font-medium leading-7 text-ink">
                        Clear choices, candid tradeoffs, and calm guidance from first conversation to closing.
                    </p>
                </div>
            </div>

            <div>
                <p class="eyebrow">Meet Inga</p>
                <h2 class="mt-4 max-w-2xl text-4xl font-extrabold sm:text-5xl">
                    Sharp, strategic, and genuinely in your corner.
                </h2>

                <p class="mt-6 text-lg text-smoke">
                    Buying or selling a home is a big decision, and my goal is to make the process feel clear and manageable from start to finish. Working with the wrong agent can be a 6-figure mistake.
                </p>

                <p class="mt-5 text-lg text-smoke">
                    I work with clients across Charlotte and the surrounding areas, guiding them through options with a steady, thoughtful approach. Some moves happen quickly, and others take time. My role is to help you understand your choices, talk through tradeoffs honestly, and make decisions that align with your goals.
                </p>

                <div class="mt-8 grid gap-3 sm:grid-cols-3">
                    {stats.map((stat) => (
                        <div class="soft-card p-5">
                            <p class="font-display text-3xl font-extrabold text-ink">{stat.value}</p>
                            <p class="mt-1 text-sm text-deep-rose">{stat.label}</p>
                        </div>
                    ))}
                </div>

                <div class="mt-8 grid gap-4 sm:grid-cols-3">
                    <div class="flex items-start gap-3">
                        <BadgeCheck class="mt-1 h-5 w-5 text-slate" />
                        <p class="text-sm text-smoke"><span class="font-medium text-ink">{siteConfig.agent.designation}</span><br />{siteConfig.compliance.licenseLine}</p>
                    </div>
                    <div class="flex items-start gap-3">
                        <Home class="mt-1 h-5 w-5 text-slate" />
                        <p class="text-sm text-smoke"><span class="font-medium text-ink">Buyer focused</span><br />First-time, relocation, and local moves</p>
                    </div>
                    <div class="flex items-start gap-3">
                        <TrendingUp class="mt-1 h-5 w-5 text-slate" />
                        <p class="text-sm text-smoke"><span class="font-medium text-ink">Investor aware</span><br />Short-term rental and property strategy</p>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>