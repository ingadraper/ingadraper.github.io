---
import { Menu } from '@lucide/astro';
import { siteConfig } from '../siteConfig';

interface Props {
    active?: 'answers';
}

const { active } = Astro.props;
const { brand } = siteConfig;
---

<header class="border-b border-white/15 bg-[#2C2927] text-ivory">
    <nav class="site-shell flex min-h-20 items-center justify-between text-sm" aria-label="Primary navigation">
        <a href="/" class="flex min-w-0 items-center gap-5 text-ivory sm:gap-6" aria-label={`Inga Draper, ${brand.brokerageName} — home`}>
            <span class="font-display text-xl font-extrabold sm:text-2xl">Inga Draper</span>
            <span class="hidden items-center gap-6 sm:flex">
                <span class="h-8 w-px flex-none bg-white/30" aria-hidden="true"></span>
                <img src={brand.logos.white} srcset={brand.logoSrcsets.white} sizes="152px" alt={brand.logoAlt} width="360" height="75" class="h-8 w-auto flex-none" />
            </span>
        </a>
        <div class="hidden items-center gap-8 font-medium text-ivory/85 md:flex">
            <a href="/#about" class="transition hover:text-ivory">About</a>
            <a href="/#services" class="transition hover:text-ivory">Services</a>
            <a href="/#strategy" class="transition hover:text-ivory">Planning</a>
            <a href="/answers/" class:list={["transition hover:text-ivory", active === 'answers' && "text-ivory"]}>Answers</a>
            <a href="/#reviews" class="transition hover:text-ivory">Reviews</a>
            <a href="/#contact" class="rounded-[6px] border border-ivory/25 bg-ink px-4 py-2 text-ivory transition hover:border-deep-rose hover:bg-deep-rose">Contact</a>
        </div>
        <details class="mobile-nav relative md:hidden">
            <summary class="flex h-11 w-11 cursor-pointer list-none items-center justify-center rounded-[6px] border border-white/30 bg-ink text-ivory focus:outline-none focus:ring-2 focus:ring-ivory">
                <Menu class="h-5 w-5" aria-hidden="true" />
                <span class="sr-only">Open primary navigation</span>
            </summary>
            <div class="absolute right-0 top-full z-30 mt-3 w-56 overflow-hidden rounded-[8px] border border-white/20 bg-[#2C2927] p-2 shadow-2xl">
                <a href="/#about" class="block min-h-11 rounded-[6px] px-4 py-3 hover:bg-white/10">About</a>
                <a href="/#services" class="block min-h-11 rounded-[6px] px-4 py-3 hover:bg-white/10">Services</a>
                <a href="/#strategy" class="block min-h-11 rounded-[6px] px-4 py-3 hover:bg-white/10">Planning</a>
                <a href="/answers/" class="block min-h-11 rounded-[6px] px-4 py-3 hover:bg-white/10">Answers</a>
                <a href="/#reviews" class="block min-h-11 rounded-[6px] px-4 py-3 hover:bg-white/10">Reviews</a>
                <a href="/#contact" class="mt-1 block min-h-11 rounded-[6px] bg-ivory px-4 py-3 font-medium text-ink">Contact Inga</a>
            </div>
        </details>
    </nav>
</header>
