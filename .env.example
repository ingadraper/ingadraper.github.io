# Public GoHighLevel connector URLs.
# These are public embed/widget values, not private API keys or tokens.
# You can also paste these public values into src/siteConfig.ts for GitHub Pages.

# Example format: https://api.leadconnectorhq.com/widget/form/YOUR_FORM_ID
PUBLIC_GHL_FORM_URL=

# Example format: https://api.leadconnectorhq.com/widget/booking/YOUR_CALENDAR_ID
PUBLIC_GHL_CALENDAR_URL=

# GoHighLevel chat widget id only, if using the chat widget loader.
PUBLIC_GHL_CHAT_WIDGET_ID=
